<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.phase-link')];
  const sections = links.map(l => document.getElementById(l.dataset.phase!)!);

  function update() {
    const probe = window.innerHeight * 0.35;
    // Active section = last one whose header has scrolled past the probe line (Context until then)
    let active = 0;
    sections.forEach((s, i) => { if (s.getBoundingClientRect().top <= probe) active = i; });
    links.forEach((l, i) => {
      const on = i === active;
      l.classList.toggle('text-gray-900', on);
      l.classList.toggle('font-semibold', on);
      l.classList.toggle('text-gray-400', !on);
      const dot = l.previousElementSibling!;
      dot.classList.toggle('bg-gray-900', on);
      dot.classList.toggle('bg-gray-300', !on);
    });
  }

  links.forEach((l, i) => l.addEventListener('click', e => {
    e.preventDefault();
    sections[i].scrollIntoView({ behavior: 'smooth', block: 'start' });
    history.replaceState(null, '', `#${l.dataset.phase}`);
  }));

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>

