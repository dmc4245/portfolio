---
// Vertical timeline nav for case studies: fixed beside the article on desktop,
// hidden on smaller screens. Highlights the section currently in view.
// Each item's `id` must match an element id on the page (give it `scroll-mt-20`).
interface Props {
  items: { id: string; label: string }[];
  label?: string;
  class?: string;
}

const { items, label = 'Page sections', class: className = '' } = Astro.props;
---

<nav aria-label={label} class={`section-nav not-prose hidden desktop:block desktop:fixed desktop:top-1/3 desktop:left-[calc(50%-384px-170px)] desktop:w-36 ${className}`}>
  <ol class="relative border-l border-gray-200 ml-1 space-y-5">
    {items.map(item => (
      <li class="relative pl-5">
        <span class="absolute -left-[5px] top-1.5 w-[9px] h-[9px] rounded-full bg-gray-300 transition-colors" aria-hidden="true"></span>
        <a href={`#${item.id}`} data-section={item.id} class="section-link block text-sm text-gray-400 hover:text-gray-900 transition-colors">{item.label}</a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.section-link')];
  const sections = links.map(l => document.getElementById(l.dataset.section!)!);

  function update() {
    const probe = window.innerHeight * 0.35;
    // Active section = last one whose header has scrolled past the probe line (first item until then)
    let active = 0;
    sections.forEach((s, i) => { if (s && s.getBoundingClientRect().top <= probe) active = i; });
    links.forEach((l, i) => {
      const on = i === active;
      l.classList.toggle('text-gray-900', on);
      l.classList.toggle('font-semibold', on);
      l.classList.toggle('text-gray-400', !on);
      const dot = l.previousElementSibling!;
      dot.classList.toggle('bg-gray-900', on);
      dot.classList.toggle('bg-gray-300', !on);
    });
  }

  links.forEach((l, i) => l.addEventListener('click', e => {
    e.preventDefault();
    sections[i]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    history.replaceState(null, '', `#${l.dataset.section}`);
  }));

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>
