---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Product design portfolio' } = Astro.props;

// Same source and order as the homepage work list
const projectModules = await Astro.glob('../pages/work/project-*.astro');
const projects = projectModules
  .map(mod => mod.projectMeta)
  .filter(Boolean)
  // Optional projectMeta.order pins projects to the top; the rest follow by file name
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99) || a.href.localeCompare(b.href));
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/icons/Red flower.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&display=swap" rel="stylesheet" />
  <style is:global>
    h2 { font-family: 'IBM Plex Mono', monospace; font-weight: 400 !important; text-transform: uppercase; letter-spacing: 0.1em; color: #9ca3af; border-top: 1px solid #d1d5db; padding-top: 1.5rem; margin-top: 2.5rem; }
  </style>
  </head>
  <body class="bg-[#F6F7F1] text-gray-900 antialiased">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-[#F6F7F1]/90 backdrop-blur-sm border-b border-gray-100">
      <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
        <a href="/" id="nav-logo" class="group relative flex items-center text-sm font-bold uppercase tracking-widest font-poppins" style="color: #FEC202;">
          <!-- Text: fades out on hover -->
          <span class="transition-all duration-500 ease-in-out group-hover:opacity-0 group-hover:scale-95 whitespace-nowrap">
            Diana Minji Chun
          </span>
          <!-- Icons + HOME: fade in on hover -->
          <span class="absolute left-0 flex items-center gap-2 opacity-0 scale-90 transition-all duration-500 ease-in-out group-hover:opacity-100 group-hover:scale-100 pointer-events-none">
            <svg width="16" height="16" aria-hidden="true"><use href="/icons/sprite.svg#icon-blue-12-star" /></svg>
            <span class="inline-flex items-center gap-0.5 text-sm font-bold font-poppins" style="color: #FEC202;">
              <span>H</span><span>O</span><span>M</span><span>E</span>
            </span>
            <svg width="16" height="16" aria-hidden="true"><use href="/icons/sprite.svg#icon-green-4-star" /></svg>
            <svg width="16" height="16" aria-hidden="true"><use href="/icons/sprite.svg#icon-red-flower" /></svg>
          </span>
        </a>
        <div class="flex items-center gap-8 text-sm">
          <!-- Work dropdown: opens on hover (mouse) or click/tap; lists every project -->
          <div id="work-menu" class="relative">
            <button id="work-menu-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="work-menu-panel" class="flex items-center gap-1 font-poppins font-normal uppercase tracking-widest text-gray-400 hover:text-gray-600 transition-colors">
              Work
              <svg class="w-3 h-3 transition-transform" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <div id="work-menu-panel" class="hidden fixed left-4 right-4 top-14 tablet:absolute tablet:left-auto tablet:right-0 tablet:top-full tablet:pt-3 tablet:w-80">
              <ul class="bg-[#F6F7F1] border border-gray-200 rounded-lg shadow-lg p-2">
                {projects.map(p => {
                  const current = currentPath === p.href;
                  return (
                    <li>
                      <a href={p.href} aria-current={current ? 'page' : undefined} class={`flex items-center gap-3 px-3 py-2 rounded-md hover:bg-white transition-colors ${current ? 'bg-white' : ''}`}>
                        <img src={p.image} alt="" class="w-6 h-6 rounded shrink-0" />
                        <span class={`text-sm leading-snug ${current ? 'font-semibold text-gray-900' : 'text-gray-700'}`}>{p.title}{p.comingSoon && <span class="ml-1.5 inline-block align-middle px-1.5 py-0.5 rounded-full bg-[#FEC202]/25 text-[10px] font-normal uppercase tracking-widest text-gray-700 whitespace-nowrap" style="font-family: 'IBM Plex Mono', monospace;">Soon</span>}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
          <a href="/about" class="font-poppins font-normal uppercase tracking-widest text-gray-400 hover:text-gray-600 transition-colors">About</a>
        </div>
      </div>
    </nav>

    <script>
      document.getElementById('nav-logo')?.addEventListener('click', function(e) {
        if (window.location.pathname === '/') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('replay-logo-anim'));
        }
      });

      // Work dropdown
      const workMenu = document.getElementById('work-menu')!;
      const workBtn = document.getElementById('work-menu-btn')!;
      const workPanel = document.getElementById('work-menu-panel')!;
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      let closeTimer: ReturnType<typeof setTimeout> | undefined;

      function setWorkMenu(open: boolean) {
        clearTimeout(closeTimer);
        workPanel.classList.toggle('hidden', !open);
        workBtn.setAttribute('aria-expanded', String(open));
        workBtn.querySelector('svg')!.classList.toggle('rotate-180', open);
      }

      workBtn.addEventListener('click', () => setWorkMenu(workPanel.classList.contains('hidden')));
      if (canHover) {
        workMenu.addEventListener('mouseenter', () => setWorkMenu(true));
        workMenu.addEventListener('mouseleave', () => { closeTimer = setTimeout(() => setWorkMenu(false), 150); });
      }
      document.addEventListener('click', e => { if (!workMenu.contains(e.target as Node)) setWorkMenu(false); });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !workPanel.classList.contains('hidden')) { setWorkMenu(false); workBtn.focus(); }
      });
    </script>

    <main class="pt-14">
      <slot />
    </main>

    <footer class="border-t border-gray-100 mt-24">
      <!-- AI use disclaimer: on every page, below the content -->
      <div class="max-w-5xl mx-auto px-6 pt-8">
        <p class="text-xs uppercase tracking-widest text-gray-400 mb-3" style="font-family: 'IBM Plex Mono', monospace;">AI use disclaimer</p>
        <div class="text-xs text-gray-400 max-w-xl leading-relaxed space-y-3">
          <p>This site was built and written with AI tools — intentionally. I vibe-coded the front-end from scratch using Claude Code, and used Claude and Microsoft Copilot to help format, rewrite, and pressure-test my case study copy.</p>
          <p>What you're reading reflects my thinking. I directed every decision, approved every word, and verified every number. AI helped me move faster so I can think more deeply.</p>
        </div>
      </div>
      <div class="max-w-5xl mx-auto px-6 py-8 flex items-center justify-between text-sm text-gray-400">
        <span>© {new Date().getFullYear()} Diana Minji Chun</span>
        <a href="mailto:diana.chun@outlook.com" class="hover:text-gray-900 transition-colors">
          diana.chun@outlook.com
        </a>
      </div>
    </footer>
  </body>
</html>
